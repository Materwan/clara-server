# Generate any token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The server refuses to start while a token still begins with "change-me".

# Chat clients (terminal, Discord, apps): "name:token" pairs, comma separated.
# One token per client so each can be revoked on its own. Required.
CLARA_TOKENS=terminal:change-me,discord:change-me-too

# Which surfaces each client may speak for: "client=surface|surface" pairs. A client listed here
# can only read and write the people, facts and conversations of those surfaces (a conversation id
# must start with "<surface>:"). A client with no entry may use any surface, and the server warns.
# CLARA_CLIENT_SURFACES=terminal=cli|console,discord=discord

# People do not need a token: they have a user name and a password (see "Users" in the README). Make the
# first one, an administrator, with `/user add <name> admin` in the server's console, or from another computer:
#   clara-admin --token <an admin token below> "/user add erwan admin"
# CLARA_TOKENS is still needed for programs that speak for several people (the Discord bot).
# Days a login lasts without being used, then the password is asked again (0: for ever)
# CLARA_SESSION_DAYS=90
# A login never lasts longer than this many days, however often it is used (0: no limit)
# CLARA_SESSION_MAX_DAYS=365
# Surfaces a user may log in on: the web site is "web", the desktop app "app", clara-chat "cli", custom-console "console"
# CLARA_USER_SURFACES=web,app,cli,console
# true: the web site's sign-in page lets anybody make their own user (never an administrator). Off, only administrators
# make users. Leave it off on a server strangers can reach (Tailscale Funnel).
# CLARA_WEB_SIGNUP=false
# true: somebody who made their own user (sign-up, Discord /register) may connect GitHub, Google Drive and folders
# at once. Off: an administrator switches the integrations on for them (Administration page).
# CLARA_SIGNUP_INTEGRATIONS=false
# Surfaces where a client (the Discord bot) signs its people in, with /register or /login: there, an account that is
# not signed in as a user cannot talk to Clara. "none": nowhere (anybody the client speaks for may talk)
# CLARA_LOGIN_SURFACES=discord

# --- Discord bot (built in; needs pip install -e ".[discord]") --------------------------------------
# The bot's token (Discord developer portal > your application > Bot; turn on the Message Content and
# Server Members intents on the same page). Never leaves this file.
# DISCORD_BOT_TOKEN=
# true: the bot starts with the server. Either way, /discord start|stop or the web site's Discord page
# start and stop it until the next restart.
AUTO_START_DISCORD_BOT=false
# The invite link shown on the web site (empty: built from the bot's id)
# DISCORD_BOT_INVIT_URL=

# Operators: tokens for the remote console (`clara-admin`). They are NOT chat tokens
# (and cannot be the same value). Leave empty to disable remote admin entirely.
CLARA_ADMIN_TOKENS=ops:change-me-as-well

# --- Language model providers ------------------------------------------------
# Which one is used at first start; /provider in the console switches it live
# and the choice is remembered in the data dir. local | cloud | gemini | deepseek | mistral
CLARA_PROVIDER=local

# "local" = Local host: Ollama on this machine (or any host)
# OLLAMA_HOST=http://localhost:11434
# A model you have pulled (`ollama pull llama3.2`). Models ending in "-cloud" are not local: Ollama
# forwards them to ollama.com, which needs `ollama signin`, and the context window requested from
# a local server (num_ctx) cannot be relied on for them. If you use one here, set
# CLARA_LOCAL_CONTEXT_WINDOW to the window the model really has.
CLARA_LOCAL_MODEL=llama3.2

# "cloud" = Ollama API key: ollama.com, authenticated with your key
# (create one at https://ollama.com/settings/keys). Never leaves this file.
# OLLAMA_API_KEY=
# With the key, Clara can also search the web and read pages (web_search, web_fetch, through ollama.com).
# Set to false to keep her offline.
# CLARA_WEB_TOOLS=true
# web_fetch only reads addresses the person wrote or web_search returned: a page can tell Clara to fetch an address
# that carries what she knows about the person. true: any address (only for a server whose users you trust).
# CLARA_WEB_FETCH_ANY_URL=false

# Music Assistant (the music_* tools and the Music page): its address. Each person chooses their own player (the one
# of the PC they control) and gives the token of their own Music Assistant user on the Music page: it is kept encrypted
# in the database, never given back, and only that player is ever controlled. Secrets stay out of the repository.
# MUSIC_ASSISTANT_URL=http://100.104.72.57:8095
CLARA_CLOUD_MODEL=gpt-oss:120b

# Gemini, DeepSeek and Mistral, through their OpenAI-compatible API. A provider without its key is listed but cannot
# be chosen. Keys never leave this file. Each one also takes CLARA_<ID>_HOST and CLARA_<ID>_CONTEXT_WINDOW.
# "gemini" = Google Gemini (key: https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# CLARA_GEMINI_MODEL=gemini-flash-latest
# CLARA_GEMINI_CONTEXT_WINDOW=1048576
# "deepseek" = DeepSeek (key: https://platform.deepseek.com/api_keys)
# DEEPSEEK_API_KEY=
# CLARA_DEEPSEEK_MODEL=deepseek-flash
# CLARA_DEEPSEEK_CONTEXT_WINDOW=1000000
# DeepSeek thinks before answering (slower, shows its reasoning); false turns it off
# CLARA_DEEPSEEK_THINKING=true
# "mistral" = Mistral (key: https://console.mistral.ai/api-keys)
# MISTRAL_API_KEY=
# CLARA_MISTRAL_MODEL=mistral-large-latest
# CLARA_MISTRAL_CONTEXT_WINDOW=131072

# --- Projects ------------------------------------------------------------------
# What one project may hold: millions of characters of text, and files
# CLARA_PROJECT_MAX_MB=20
# CLARA_PROJECT_MAX_FILES=5000
# A project's files all go in the prompt while they take less than this share of the model's context window, in
# percent; beyond, Clara searches and reads them with tools (0: always with tools)
# CLARA_PROJECT_INLINE_PERCENT=40
# Private GitHub repositories (public ones need nothing): a fine-grained token with read access to their contents.
# It is the operator's own access: only administrators' project downloads use it. Everybody else uses the GitHub
# account they connect on the Integrations page. true: every user's downloads use it (only on a server whose
# users you trust with everything the token can read).
# GITHUB_TOKEN=
# CLARA_GITHUB_TOKEN_SHARED=false

# --- Integrations (GitHub, Google Drive and folders Clara works on live) --------------------------
# Key that encrypts the accounts people connect (a Fernet key, or any long text). Empty: one is made in
# data/secret.key. Lose it and the connected accounts must be connected again.
# CLARA_SECRET_KEY=
# Google Drive: an OAuth client of a Google Cloud project with the Drive API enabled (application type "Web
# application"; keep it "In production" or Google ends each connection after 7 days). Its redirect URI is
# <the server's address>/v1/integrations/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The address people reach the server at (https://...), when the redirect cannot be worked out from the request
# (behind a proxy)
# CLARA_PUBLIC_URL=
# Seconds a request for permission waits in its conversation before it is pushed to the person's other devices
# (0: never; each person can change it), and before it lapses
# CLARA_APPROVAL_NOTIFY_AFTER=60
# CLARA_APPROVAL_EXPIRE_AFTER=86400

# --- Usage limits --------------------------------------------------------------
# Credits a day (prompt + answer tokens times the weight of the model, counted per person, a day ends at midnight
# UTC) that a user may use when an administrator set no limit for them: 500000, 500k, 2m... Empty or off: no
# limit. Administrators never have one. Change it later with /limit default <credits>, and a user's with
# /limit <user> <credits>.
# CLARA_DEFAULT_DAILY_TOKENS=
# Billions of parameters a model of weight 1 has (one credit a token): a 120B model then costs 15 credits a token,
# a 1B model 0.125. Which models users may choose, and their weights: the web site's Admin, Models tab, or /models.
# CLARA_WEIGHT_REFERENCE_B=8

# --- Network and storage -----------------------------------------------------
# Keep 127.0.0.1 unless the server sits behind a VPN / reverse proxy.
CLARA_HOST=127.0.0.1
CLARA_PORT=8765
CLARA_DATA_DIR=data

# --- Tailscale (reach the server from other machines without opening a port) --------------------------
# off     : nothing (default)
# serve   : https://<machine>.<tailnet>.ts.net, reachable by the devices of your tailnet only
# funnel  : the same URL, open to the whole internet (only the tokens protect it: each must have 32+ characters)
# Tailscale must be installed and logged in (`sudo tailscale up`), with MagicDNS and HTTPS certificates enabled.
# The server keeps listening on 127.0.0.1 (leave CLARA_HOST alone), sets the mapping at startup and removes it
# when it stops. The URL is in the log and in /status.
# CLARA_TAILSCALE=off
# HTTPS port on the Tailscale side: 443, 8443 or 10000. Clara owns it while this is on.
# CLARA_TAILSCALE_PORT=443
# CLARA_TAILSCALE_BIN=tailscale
# An address (other than this machine) that sends this many wrong tokens in a minute is refused for
# CLARA_AUTH_BLOCK_SECONDS with HTTP 429 (0: never)
# CLARA_AUTH_MAX_FAILURES=10
# CLARA_AUTH_BLOCK_SECONDS=300

# Context window of each provider, in tokens. The percentages clients show, and the moment a
# conversation is compacted, are relative to it. "local" also asks Ollama for exactly that window
# (Ollama's own default is tiny).
# CLARA_LOCAL_CONTEXT_WINDOW=32768
# CLARA_CLOUD_CONTEXT_WINDOW=131072
# Summarise a conversation when its context is this full, in percent (0 = never)
# CLARA_COMPACT_PERCENT=80
# ...or when the messages of a conversation alone (not the system prompt or the tools) weigh this many tokens: every
# model round sends them again (0 = never)
# CLARA_COMPACT_TOKENS=40000
# Tools a surface is not offered, as surface=tool|tool,surface=tool: their schemas cost tokens in every round.
# Default: discord=add_task|update_task|edit_markdown_file|github_pr (set it empty to offer everything everywhere)
# CLARA_HIDDEN_TOOLS=discord=add_task|update_task|edit_markdown_file|github_pr
# Turns at the end of a conversation that a compaction leaves as they are (0 = summarise everything)
# CLARA_KEEP_RECENT_TURNS=2

# Optional tuning
# Turns of a conversation (a message and everything that followed it) the model gets back
# CLARA_HISTORY_TURNS=20
# Model rounds one turn may take (a round = one model call, possibly asking for tools)
# CLARA_MAX_TOOL_ROUNDS=20
# Seconds a client may take to run its tools and answer (it may ask its user first)
# CLARA_TOOL_TIMEOUT=900
# CLARA_MAX_CONCURRENT_LLM=2
# Answers one user may have running at once, so that one account cannot hold every slot above (0: no limit)
# CLARA_MAX_TURNS_PER_USER=2
# Delete the messages a compaction has summarised (the summary then is the only record of them;
# the older conversation can no longer be read back). Default: keep them.
# CLARA_PURGE_SUMMARISED=false
# Seconds Clara has to write the announcement of a reminder that came due; 0: announce its text as typed
# CLARA_REMINDER_AI_TIMEOUT=60
# Reminders sent for one task of the to-do list before it is left alone (Clara picks and moves them herself;
# she is given the number already sent). After that the person decides: finish it, or ask for more.
# CLARA_TASK_MAX_REMINDERS=10
# A turn that lasts this many seconds notifies its person when it is done (0: never). Each person can
# set their own (/notify-after, the Account page, the app's Settings): this is for those who have not
# CLARA_NOTIFY_LONG_TURN=120

# --- Traffic log -------------------------------------------------------------
# Every request in (from clients) and out (to the model) is written to data/logs/traffic-<date>.jsonl.
# It holds what people say and what Clara knows about them, and /forget-person does not erase it.
# CLARA_TRAFFIC_LOG=true
# Days the files are kept
# CLARA_TRAFFIC_LOG_DAYS=7
# Characters kept of each body (a prompt can be long)
# CLARA_TRAFFIC_LOG_MAX_BODY=100000
# Tokens of remembered facts shown to the model in each prompt (the newest first; the model can
# find the others with its recall_facts tool)
# CLARA_FACTS_TOKEN_BUDGET=2000
# Seconds the model may take to start answering (thinking models are slow), then the longest
# pause it may make between two pieces of its answer. A model that hangs is given up on.
# CLARA_LLM_FIRST_TOKEN_TIMEOUT=300
# CLARA_LLM_IDLE_TIMEOUT=120
# A model that is overloaded (HTTP 429, 500, 502, 503, 504) or unreachable is asked again, before it has said
# anything: this many times (0 = never), waiting this many seconds the first time, then twice as long, and so on
# (or the Retry-After the service sent).
# CLARA_LLM_RETRIES=3
# CLARA_LLM_RETRY_DELAY=2
# CLARA_SYSTEM_PROMPT_FILE=config/system_prompt.md

# --- Second brain: an Obsidian vault shared with you (the vault_* tools) ----------------------------
# The folder of the vault, a git repository (github.com/<you>/second-brain cloned on this machine). Without it
# there is no vault. Clara commits every change and, with a remote, pulls and pushes it (see the vault's README).
# CLARA_VAULT_PATH=/home/you/Clara/second-brain
# Who may use it through Clara: user names, comma separated. Empty: the administrators. Never in group conversations.
# CLARA_VAULT_OWNERS=erwan
# true: also in group conversations (what a tool returns is then seen by everybody there)
# CLARA_VAULT_IN_GROUPS=false
# CLARA_VAULT_GIT=true                # commit every change
# CLARA_VAULT_PUSH=true               # push the commits (a few seconds after the last change)
# CLARA_VAULT_PULL_SECONDS=30         # bring in what you changed in Obsidian at most this often
# A token for pushing to an https remote that asks for credentials (else use SSH or a git credential helper)
# CLARA_VAULT_GIT_TOKEN=
# Search by meaning: an Ollama embedding model (ollama pull nomic-embed-text); "off" for keyword search only
# CLARA_VAULT_EMBED_MODEL=nomic-embed-text
# CLARA_VAULT_EMBED_HOST=             # default: OLLAMA_HOST
# CLARA_VAULT_MAX_CHARS=200000        # the longest note Clara writes

